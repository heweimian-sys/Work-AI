{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "航海每日情报",
  "type": "object",
  "required": ["meta", "important", "questions", "practices", "consensus", "archiveDays"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["day", "date", "coveredUntil", "messageCount", "groups", "reviewStatus", "reviewedBy"],
      "properties": {
        "day": { "type": "integer", "minimum": 0 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "coveredUntil": { "type": "string" },
        "messageCount": { "type": "integer", "minimum": 0 },
        "groups": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "reviewStatus": { "enum": ["draft", "approved"] },
        "reviewedBy": { "type": "string", "minLength": 1 }
      }
    },
    "important": { "type": "array", "items": { "$ref": "#/$defs/intel" } },
    "questions": { "type": "array", "items": { "$ref": "#/$defs/question" } },
    "practices": { "type": "array", "items": { "$ref": "#/$defs/practice" } },
    "consensus": { "type": "array", "items": { "$ref": "#/$defs/sourcedText" } },
    "archiveDays": { "type": "array", "minItems": 1 }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["group", "time"],
      "properties": { "group": { "type": "string", "minLength": 1 }, "time": { "type": "string", "minLength": 1 }, "messageIds": { "type": "array", "items": { "type": "string" } } }
    },
    "sourcedText": {
      "type": "object",
      "required": ["text", "sources"],
      "properties": { "text": { "type": "string", "minLength": 1 }, "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } } }
    },
    "intel": {
      "type": "object",
      "required": ["tag", "title", "body", "action", "sources"],
      "properties": { "tag": { "type": "string" }, "title": { "type": "string", "minLength": 1 }, "body": { "type": "string", "minLength": 1 }, "action": { "type": "string", "minLength": 1 }, "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } }
    },
    "question": {
      "type": "object",
      "required": ["question", "answer", "topic", "confirmedBy", "sources"],
      "properties": { "question": { "type": "string", "minLength": 1 }, "answer": { "type": "string", "minLength": 1 }, "topic": { "type": "string" }, "confirmedBy": { "type": "string", "minLength": 1 }, "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } }
    },
    "practice": {
      "type": "object",
      "required": ["result", "person", "method", "status", "sources"],
      "properties": { "result": { "type": "string", "minLength": 1 }, "person": { "type": "string" }, "method": { "type": "string", "minLength": 1 }, "status": { "enum": ["已有结果", "已确认", "助教确认", "已出单"] }, "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } }
    }
  }
}
